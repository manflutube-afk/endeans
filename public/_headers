# Cloudflare reads this file straight out of the deployed site — no build step.
# Rules are matched top to bottom; the most specific match wins.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Fingerprint-free filenames, so HTML must always be revalidated.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Stylesheets and scripts have no version in their filenames, so they must be
# revalidated on every visit — otherwise an edit stays invisible for as long as
# the cache lasts. They are a few kB each, and a revalidation is a cheap 304.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Images are regenerated with a new width in the filename when they change.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
