{
  // Cloudflare Pages project "endeans" — https://endeans.pages.dev
  //
  // There is no build step and no Functions directory: everything in
  // ./public is uploaded as-is and served from Cloudflare's edge.
  // Pages handles the rest natively — /services serves /services/index.html,
  // unknown paths get public/404.html with a 404 status, and public/_headers
  // sets the caching and security headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "endeans",
  "pages_build_output_dir": "./public"
}
