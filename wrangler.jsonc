{
  // Cloudflare Worker that serves the static site in ./public and nothing else.
  // There is no "main" entry point on purpose: with assets only and no script,
  // Cloudflare serves the files straight from its edge and never runs any code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "endeansbarbers",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    // "/services" and "/services/" both serve /services/index.html.
    "html_handling": "auto-trailing-slash",
    // Anything unrecognised gets public/404.html with a 404 status.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
